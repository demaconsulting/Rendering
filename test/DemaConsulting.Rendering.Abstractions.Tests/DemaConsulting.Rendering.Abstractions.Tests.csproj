<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Build Configuration -->
    <!-- net481 runs this suite against the netstandard2.0 assets of the code under test, which is how a
         Roslyn analyzer hosted by Visual Studio or MSBuild.exe loads them. It is Windows-only because
         the .NET Framework reference and runtime assemblies are not available on Linux or macOS. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net481;net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- xUnit v4 has built-in Microsoft.Testing.Platform (MTP) support. This property makes the
         compiled test assembly a standalone MTP executable, which `dotnet test` (.NET 10 SDK)
         invokes directly - without VSTest/vstest.console. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

    <!-- Code Quality Configuration -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Implicit Usings -->
  <ItemGroup>
    <Using Include="Polyfills" />
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- net481 Runtime Dependencies -->
  <!-- System.Memory is required on net481 to resolve assembly binding conflicts introduced by
       transitive dependencies (e.g. Polyfill) that reference System.Memory 4.0.x. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- Test Framework Dependencies -->
  <!-- xunit.v3 4.x has built-in Microsoft.Testing.Platform (MTP) support, so xunit.runner.visualstudio
       (the VSTest adapter) and Microsoft.NET.Test.Sdk (the VSTest host) are no longer required.
       coverlet.collector - a VSTest data collector - is replaced by the MTP-native
       Microsoft.Testing.Extensions.CodeCoverage extension (enabled via the dotnet test coverage option), and
       Microsoft.Testing.Extensions.TrxReport adds the report-trx option so TRX result files
       (consumed by ReqStream) continue to be produced. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <!-- Code Analysis Dependencies -->
  <ItemGroup>
    <!-- Analyzer packages use child-element form to configure both PrivateAssets and IncludeAssets:
         - PrivateAssets="all" prevents these build-time analyzers from becoming transitive dependencies
           in any project that references this test project.
         - IncludeAssets lists all asset types (including 'analyzers' and 'buildtransitive') to ensure
           Roslyn analyzers and MSBuild targets are fully activated during the build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Project References -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\DemaConsulting.Rendering.Abstractions\DemaConsulting.Rendering.Abstractions.csproj" />
  </ItemGroup>

</Project>


